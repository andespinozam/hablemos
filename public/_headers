# Netlify: encabezados de seguridad y caché. (La política de contenido va en <meta> dentro del HTML.)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# El service worker, el HTML y el manifiesto siempre se revalidan: así las actualizaciones llegan.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Los archivos con hash en el nombre no cambian nunca.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
